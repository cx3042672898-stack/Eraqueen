// ── 状态（viewMode: 'room' | 'interact' | 'simple'）────────
var _s = {charId:null, viewMode:'room', showMaster:true, showSlave:true, modal:null, action:null, story:null, speech:null, animOn:false};
var _speakTimer=null, _dragData=null;
var _animTimer=null, _animT=0;
